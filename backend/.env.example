# ====================================================================
# 多智能体学习规划助手 - 环境变量配置模板
# ⚠️ 安全提示：
# 1. 复制此文件为 .env 后填入真实密钥
# 2. .env 文件已在 .gitignore 中，不会被提交到 GitHub
# 3. 切勿将真实密钥提交到版本控制！
# ====================================================================

# ==================== 必填配置 ====================
# DeepSeek API密钥（用于LLM推理）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ==================== 可选配置 ====================
# Tavily 搜索密钥（联网兜底：本地知识库不足时补充实时学习资源）
# 填入真实 key 即自动启用；留空则只用本地知识库 + LLM 兜底
TAVILY_API_KEY=your_tavily_api_key_here

# 联网兜底开关（默认 true；设为 false 可强制关闭外部请求）
WEB_SEARCH_ENABLED=true

# Hermes配置（可选，用于任务看板同步）
HERMES_API_KEY=your_hermes_api_key_here

# API基础URL（可选，默认使用DeepSeek官方地址）
API_BASE_URL=https://api.deepseek.com/v1/chat/completions
# 后端监听端口（默认 8001；本机 8000 常被 Docker 等服务占用，不要改回 8000）
API_PORT=8001


# ==================== RAG参数配置（可选，不填使用默认值） ====================
# 检索充分阈值（仅基础版 Self-RAG 使用；增强版改用下方两级门控与质量分 decision）
RAG_SIMILARITY_THRESHOLD=0.5

# 最低可用阈值：低于此值的知识库结果直接丢弃
RAG_MIN_KB_SIMILARITY=0.15

# 最大查询改写次数
RAG_MAX_REWRITE_TIMES=2

# 候选检索数量（先召回再由 Cross-Encoder 精排）
RAG_CANDIDATE_K=10

# 最终保留资源数
RAG_TOP_K=5

# 是否启用 Cross-Encoder 重排
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=BAAI/bge-reranker-base

# 重排置信度门控：首位候选置信度低于此值时保留融合顺序（0 表示关闭门控，全量重排）
RAG_RERANK_MIN_CONFIDENCE=0

# RAG 运行时质量通过阈值
RAG_QUALITY_THRESHOLD=0.55

# ── 库外查询识别：两级门槛（标定依据见 docs/ARCHITECTURE.md）──
# RRF 融合前绝对门槛：dense 真实余弦低于此值不参与融合；全灭则跳过融合直接联网。
# 评测链路不传这两个参数，因此不受影响。
RAG_RRF_MIN_DENSE_SIMILARITY=0.25
RAG_RRF_MIN_BM25_SCORE=1.0

# 硬线：两路绝对信号同时低于 → 判知识库无覆盖，跳过改写直接联网
RAG_HARD_COSINE=0.25
RAG_HARD_LOGIT=0.5

# 软线：任一路低于 → 改写查询重试，达到次数上限后联网
RAG_SOFT_COSINE=0.28
RAG_SOFT_LOGIT=0.65

# 结果中最少覆盖的资源类型数（0 表示关闭多样性约束）
RAG_MIN_TYPES=0

# 计划再生阈值：评估均分 < 此值时自动重新生成
REGENERATION_THRESHOLD=6.0

# 最大再生轮数
MAX_REGENERATION_ROUNDS=3
