# ====================================================================
# 多智能体学习规划助手 - 环境变量配置模板
# ⚠️ 安全提示：
# 1. 复制此文件为 .env 后填入真实密钥
# 2. .env 文件已在 .gitignore 中，不会被提交到 GitHub
# 3. 切勿将真实密钥提交到版本控制！
# ====================================================================

# ==================== 必填配置 ====================
# DeepSeek API密钥（用于LLM推理）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ==================== 可选配置 ====================
# Tavily搜索密钥（用于网络搜索学习资源，不配置则仅使用本地知识库）
TAVILY_API_KEY=your_tavily_api_key_here

# Hermes配置（可选，用于任务看板同步）
HERMES_API_KEY=your_hermes_api_key_here

# API基础URL（可选，默认使用DeepSeek官方地址）
API_BASE_URL=https://api.deepseek.com/v1/chat/completions

# ==================== RAG参数配置（可选，不填使用默认值） ====================
# 检索充分阈值：知识库结果平均相似度 >= 此值时认为结果足够
RAG_SIMILARITY_THRESHOLD=0.5

# 最低可用阈值：低于此值的知识库结果直接丢弃
RAG_MIN_KB_SIMILARITY=0.15

# 最大查询改写次数
RAG_MAX_REWRITE_TIMES=2

# 候选检索数量（先召回再由 Cross-Encoder 精排）
RAG_CANDIDATE_K=10

# 最终保留资源数
RAG_TOP_K=5

# 是否启用 Cross-Encoder 重排
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=BAAI/bge-reranker-base

# RAG 运行时质量通过阈值
RAG_QUALITY_THRESHOLD=0.55

# 计划再生阈值：评估均分 < 此值时自动重新生成
REGENERATION_THRESHOLD=6.0

# 最大再生轮数
MAX_REGENERATION_ROUNDS=3
